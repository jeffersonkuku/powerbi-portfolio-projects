						Compressed = Binary.FromText("bY47C8MwDIT/StCspe+ufawtJRkymAwiFknAtcARtP73VadCHRBC3Hd3yLkVQpN95FxdzldAuDet7RtrEujQrREelBI9SZVKvEE4BX5T9GlawFtTJOlY1dlziXd209yLlmhvCr96mjX8gjUPk0QKX8MBoZUQJA42i46jvc4xTTr+13cf", BinaryEncoding.Base64),
						Decompressed = Binary.Decompress(Compressed, Compression.Deflate),
						Rows = Json.Document(Decompressed),
						Source = Table.FromRows(Rows, {"SiteID", "SiteName", "State", "SiteType"}),
						#"Changed Type" = Table.TransformColumnTypes(Source,{{"SiteID", Int64.Type}, {"SiteName", type text}, {"State", type text}, {"SiteType", type text}})
