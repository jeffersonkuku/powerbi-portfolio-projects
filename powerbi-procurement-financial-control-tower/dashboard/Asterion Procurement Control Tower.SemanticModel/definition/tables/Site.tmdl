		summarizeBy: none
		sourceColumn: SiteName

	column State
		dataType: string
		summarizeBy: none
		sourceColumn: State

	column SiteType
		dataType: string
		summarizeBy: none
		sourceColumn: SiteType

	partition Site = m
		mode: import
		source =
