table Supplier

	column SupplierID
		dataType: int64
		summarizeBy: none
		sourceColumn: SupplierID
		isHidden

	column SupplierName
		dataType: string
		summarizeBy: none
		sourceColumn: SupplierName

	column Country
		dataType: string
		summarizeBy: none
		sourceColumn: Country

	column RiskLevel
		dataType: string
		summarizeBy: none
		sourceColumn: RiskLevel

	column PrimaryCategoryID
		dataType: int64
		summarizeBy: none
		sourceColumn: PrimaryCategoryID

	column QualityScore
		dataType: double
		summarizeBy: none
		sourceColumn: QualityScore

	column Preferred
		dataType: string
		summarizeBy: none
		sourceColumn: Preferred

	partition Supplier = m
		mode: import
		source =
			let
						Compressed = Binary.FromText("", BinaryEncoding.Base64),
						Decompressed = Binary.Decompress(Compressed, Compression.Deflate),
						Rows = Json.Document(Decompressed),
						Source = Table.FromRows(Rows, {"SupplierID", "SupplierName", "Country", "RiskLevel", "PrimaryCategoryID", "QualityScore", "Preferred"}),
						#"Changed Type" = Table.TransformColumnTypes(Source,{{"SupplierID", Int64.Type}, {"SupplierName", type text}, {"Country", type text}, {"RiskLevel", type text}, {"PrimaryCategoryID", Int64.Type}, {"QualityScore", type number}, {"Preferred", type text}})
					in
						#"Changed Type"
